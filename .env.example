# ============================================================
#  SentinelAI — environment configuration (EXAMPLE TEMPLATE)
# ============================================================
#
#  This file is a TEMPLATE. It contains no real secrets.
#
#  To use it:
#      1. Copy this file to ".env" in the project root.
#      2. Fill in real values in your local .env file.
#
#  config/settings.py reads ENVIRONMENT from this file or from
#  the operating system environment.

# --- General ---
ENVIRONMENT=development

# --- Data (used in later phases) ---
DATA_DIR=./data/raw

# --- Database (used in later phases) ---
DB_PATH=./database/sentinel.db
